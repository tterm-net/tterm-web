# tTerm Web on this computer. Every line is optional: the defaults fit the
# laptop setup. To change something, copy this file to .env and uncomment the
# line. .env never goes to git.

# PostgreSQL: Postgres.app on port 5433, database tterm_web.
# TTERM_DATABASE_URL=postgresql://localhost:5433/tterm_web

# The page's port, on this computer only.
# TTERM_PAGE_PORT=8090

# Where machines talk to us. The tunnel to connect-dev.tterm.net points here.
# TTERM_CONNECT_PORT=8091
# TTERM_CONNECT_URL=https://connect-dev.tterm.net

# Your name as the page shows it, given at the very first start. By default,
# the full name of your account on this computer. From 0.0.10 you change it
# on the account page, and later starts leave it as you set it.
# TTERM_OWNER_NAME=Denis Gerasimenko

# The address you sign in with (from 0.0.9): the machines and the history on
# this computer are yours under it. Needed once this computer has them.
# Without it, and with nothing here yet, everyone just signs up.
# TTERM_OWNER_EMAIL=you@example.com

# The page's address as the browser sees it. Requests for any other Host
# are refused.
# TTERM_PAGE_URL=http://localhost:8090

# Email for the codes: Brevo's API key. Without it each email goes to the
# window tTerm Web runs in, code and all.
# TTERM_BREVO_KEY=
# TTERM_MAIL_FROM="tTerm <login@tterm.net>"

# What the sign-in screens link to: the Terms of Service, the Privacy Policy
# and support's address. Whoever runs tTerm Web for others puts their own.
# TTERM_TERMS_URL=https://tterm.net/terms
# TTERM_PRIVACY_URL=https://tterm.net/privacy
# TTERM_SUPPORT_EMAIL=support@tterm.net

# The signer keeps the CA keys and its journal here; nobody else reads them.
# TTERM_SIGNER_DIR=data/signer
# How the core reaches the signer. By default a socket in the signer's
# folder, or in a private temporary folder if that path would be too long.
# TTERM_SIGNER_SOCKET=data/signer/signer.sock
# On a server, where the signer runs as a user of its own: the group whose
# members (the core) may reach its socket. See deploy/.
# TTERM_SIGNER_GROUP=
