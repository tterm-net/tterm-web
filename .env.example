# tTerm Web on this computer. Every line is optional: the defaults fit the
# laptop setup. To change something, copy this file to .env and uncomment the
# line. .env never goes to git.

# PostgreSQL: Postgres.app on port 5433, database tterm_web.
# TTERM_DATABASE_URL=postgresql://localhost:5433/tterm_web

# The page, only on this computer.
# TTERM_PAGE_PORT=8090

# Where machines talk to us. The tunnel to connect-dev.tterm.net points here.
# TTERM_CONNECT_PORT=8091
# TTERM_CONNECT_URL=https://connect-dev.tterm.net

# Your name as the page shows it. By default, the full name of your account
# on this computer.
# TTERM_OWNER_NAME=Denis Gerasimenko

# The signer keeps the CA keys and its journal here; nobody else reads them.
# TTERM_SIGNER_DIR=data/signer
# How the core reaches the signer. By default a socket in the signer's
# folder, or in a private temporary folder if that path would be too long.
# TTERM_SIGNER_SOCKET=data/signer/signer.sock
